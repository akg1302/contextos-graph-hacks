# Choose your FalkorDB Cloud endpoint to avoid local Docker/WSL setup.
# Copy this file to .env and fill in values from your FalkorDB Cloud console.
FALKORDB_HOST=your-cloud-hostname
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=replace-with-your-cloud-password
# Set true only if the connection details explicitly specify TLS/SSL; the free plan may not include TLS.
FALKORDB_SSL=false
FALKORDB_GRAPH=contextos_demo

# Optional; core graph demo works without an LLM API key.
OPENAI_API_KEY=
